{
 "openapi": "3.0.3",
 "info": {
  "title": "Clinic booking API",
  "version": "1.0",
  "description": "The exact contract for Task 1 of the Koya Cohort 4 assessment. Build these endpoints so our checks can talk to your API.\n\nEverything is JSON. Each endpoint says which level it belongs to. Every error response looks like `{\"error\": \"<message>\"}`.\n\nEvery request needs the `X-API-Key` header (level 2). A missing or wrong key returns **401**."
 },
 "components": {
  "securitySchemes": {
   "apiKey": {
    "type": "apiKey",
    "in": "header",
    "name": "X-API-Key",
    "description": "A key you choose. Missing or wrong: 401. (Level 2)"
   }
  },
  "schemas": {
   "Slot": {
    "type": "object",
    "required": [
     "id",
     "provider",
     "start",
     "end"
    ],
    "properties": {
     "id": {
      "type": "string",
      "example": "s1"
     },
     "provider": {
      "type": "string",
      "example": "Dr Ade"
     },
     "start": {
      "type": "string",
      "format": "date-time",
      "example": "2026-12-10T09:00:00Z"
     },
     "end": {
      "type": "string",
      "format": "date-time",
      "example": "2026-12-10T09:30:00Z"
     }
    }
   },
   "SlotWithAvailability": {
    "allOf": [
     {
      "$ref": "#/components/schemas/Slot"
     },
     {
      "type": "object",
      "required": [
       "available"
      ],
      "properties": {
       "available": {
        "type": "boolean",
        "description": "false while the slot has a confirmed booking"
       }
      }
     }
    ]
   },
   "NewBooking": {
    "type": "object",
    "required": [
     "slot_id",
     "name",
     "email"
    ],
    "properties": {
     "slot_id": {
      "type": "string",
      "example": "s1"
     },
     "name": {
      "type": "string",
      "example": "Ada Obi"
     },
     "email": {
      "type": "string",
      "example": "ada@example.com"
     }
    }
   },
   "Booking": {
    "type": "object",
    "required": [
     "id",
     "slot_id",
     "name",
     "email",
     "status",
     "created_at"
    ],
    "properties": {
     "id": {
      "type": "string",
      "description": "Any unique id you generate",
      "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
     },
     "slot_id": {
      "type": "string",
      "example": "s1"
     },
     "name": {
      "type": "string",
      "example": "Ada Obi"
     },
     "email": {
      "type": "string",
      "example": "ada@example.com"
     },
     "status": {
      "type": "string",
      "enum": [
       "confirmed",
       "cancelled"
      ],
      "example": "confirmed"
     },
     "created_at": {
      "type": "string",
      "format": "date-time",
      "example": "2026-12-01T08:15:00Z"
     }
    },
    "example": {
     "id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
     "slot_id": "s1",
     "name": "Ada Obi",
     "email": "ada@example.com",
     "status": "confirmed",
     "created_at": "2026-12-01T08:15:00Z"
    }
   },
   "Error": {
    "type": "object",
    "required": [
     "error"
    ],
    "properties": {
     "error": {
      "type": "string",
      "example": "slot not found"
     }
    }
   }
  }
 },
 "security": [
  {
   "apiKey": []
  }
 ],
